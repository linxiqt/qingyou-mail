# 生产环境在 HTTPS 反向代理后运行，PUBLIC_URL 必须是实际访问地址。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# 使用反向代理或仅在本地测试时保持 0。
WEB_TLS_PORT=0
WEB_TLS_HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# 留空即可安装和创建管理员；登录后在「域名列表」设置 SMTP 主机名。
MAIL_HOSTNAME=
# 用于在后台生成 DNS 解析指引，填写 Linux 服务器公网 IP。
MAIL_PUBLIC_IP=
# 可覆盖完整 SPF；直接投递默认生成服务器 IP 授权，中继模式需填写服务商提供的 SPF。
MAIL_SPF=
# 本地 DNS 超时或失败时，通过 HTTPS 公共解析器检查记录；可替换为其他兼容 JSON API。
DNS_DOH_FALLBACK=true
DNS_DOH_URL=https://dns.alidns.com/resolve
TRUST_PROXY=0

# 本机测试默认使用高位端口。Docker 将宿主机 25/587 映射到这里。
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SUBMISSION_PORT=1587
# 使用隐式 TLS 的第三方客户端端口。生产环境默认为下列端口，单项填 0 可关闭。
# IMAPS_PORT=993
# POP3S_PORT=995
# SMTPS_PORT=465
TLS_CERT_PATH=
TLS_KEY_PATH=
# 同时提供 IP 和域名服务时可指定另一张证书。客户端请求该域名时使用它。
TLS_SNI_HOSTNAME=
TLS_SNI_CERT_PATH=
TLS_SNI_KEY_PATH=
# 仅供本地测试；生产环境必须配置证书并保持 false。
SMTP_ALLOW_INSECURE_AUTH=false
# 旧客户端可按邮箱单独启用明文 IMAP 和 SMTP 认证。留空时关闭。
# MAIL_PLAINTEXT_ACCOUNT=user@example.com
# IMAP_PORT=143
MAX_MESSAGE_MB=20
DEFAULT_QUOTA_MB=1024

# auto：有 RELAY_HOST 时使用中继，否则直接查询收件方 MX，向其 25 端口投递。
# 可指定 direct（直投）、relay（中继）或 local（仅本地）。
OUTBOUND_MODE=auto
# 默认使用对方提供的 STARTTLS 并严格校验证书；设为 true 时要求所有外部 MX 都支持 TLS。
DIRECT_REQUIRE_TLS=false
DIRECT_DELIVERY_TIMEOUT_MS=60000
DELIVERY_MAX_ATTEMPTS=48
DELIVERY_MAX_AGE_HOURS=120
# 可选中继，不是直接收发的必需条件。
RELAY_HOST=
RELAY_PORT=587
RELAY_SECURE=false
RELAY_USER=
RELAY_PASSWORD=
# 默认 node 使用内置密钥及签名；手动配置 Rspamd 后才切换到 rspamd。
DKIM_BACKEND=node
RSPAMD_URL=http://127.0.0.1:11333/checkv2
RSPAMD_TIMEOUT_MS=10000
RSPAMD_KEY_DIR=/var/lib/postoffice-dkim
RSPAMD_SELECTOR=rspamd
RSPAMADM_PATH=/usr/bin/rspamadm
# 可选：Node.js 后端的单域名密钥覆盖。Rspamd 后端不要配置这三项。
DKIM_DOMAIN=
DKIM_SELECTOR=mail
DKIM_PRIVATE_KEY_PATH=

# Webhook 默认只允许公共 HTTPS 地址。
WEBHOOK_ALLOW_PRIVATE=false
# 远程邮局默认仅连接公共 HTTPS；只有受控内网部署才开启此项。
REMOTE_API_ALLOW_PRIVATE=false
