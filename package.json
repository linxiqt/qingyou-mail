{
  "name": "post-office",
  "version": "1.4.3",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Linux 上的 Node.js 多域名邮局与网页邮箱",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:clients": "node --test clients/ui/test/model.test.js clients/windows/test/security.test.cjs",
    "check": "node scripts/check.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "build:protected": "node scripts/build-protected.js",
    "format": "prettier --write src public test scripts deploy/nginx.conf README.md package.json compose.yaml --ignore-unknown"
  },
  "dependencies": {
    "@push.rocks/smartimap": "2.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mailparser": "^3.9.42",
    "nodemailer": "^10.1.4",
    "sanitize-html": "^2.18.1",
    "smtp-server": "^3.19.23"
  },
  "devDependencies": {
    "javascript-obfuscator": "5.9.0",
    "prettier": "^3.9.10"
  }
}
