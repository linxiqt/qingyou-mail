{
  "name": "qingyou-desktop",
  "version": "1.3.3",
  "private": true,
  "description": "青邮 Windows 多账号邮件客户端",
  "author": "Qingyou",
  "main": "main.cjs",
  "scripts": {
    "runtime": "node node_modules/electron/install.js",
    "start": "node scripts/prepare.cjs && electron .",
    "test": "node --test test/*.test.cjs",
    "build": "node scripts/prepare.cjs && electron-builder --win portable --x64",
    "build:dir": "node scripts/prepare.cjs && electron-builder --win --dir --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cloud.yilx.qingyou.desktop",
    "productName": "青邮",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "vault.cjs",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "Qingyou-Windows-${version}-${arch}.${ext}"
  }
}
